# Configuration Caddy - Reverse Proxy
#
# Deux domaines par carte (définis dans .env.prod, voir deploy/README.md) :
#   - DOMAIN        : la carte (frontend) et son API (/api/* -> backend) ;
#   - BASEROW_DOMAIN : l'interface Baserow de l'instance (équipe ; sert aussi
#                      les visuels et logos des événements).
# Caddy obtient automatiquement les certificats Let's Encrypt.
#
# Pour un test local (sans domaine) : DOMAIN=localhost, BASEROW_DOMAIN=baserow.localhost,
# BASEROW_PUBLIC_URL=http://baserow.localhost (HTTP seulement, pas de certificat).

{$DOMAIN} {
    # API backend
    handle /api/* {
        reverse_proxy backend:8080
    }

    # Frontend (fichiers statiques React)
    handle {
        reverse_proxy frontend:3080
    }

    # Logs
    log {
        output stdout
        format console
    }
}

{$BASEROW_DOMAIN} {
    # Interface Baserow de l'instance (équipe) et fichiers servis par Baserow
    reverse_proxy baserow:80

    log {
        output stdout
        format console
    }
}
