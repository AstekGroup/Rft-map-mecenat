# ============================================================
# Variables d'environnement du déploiement production (UNE carte par VPS)
# ============================================================
# Ce fichier documente deploy/.env.prod, ÉCRIT PAR scripts/deploy-v2.sh sur le
# serveur à chaque déploiement : les valeurs d'entrée viennent d'envmap
# (--env prod-<carte>), les valeurs générées du premier déploiement restent
# sur le VPS (deploy/instance/, hors rsync et hors git).
# Ne pas remplir à la main : lancer `pnpm deploy:v2 <CARTE>`.

# Carte (fichier de config embarqué dans les images ; obligatoire)
APP_CONFIG_FILE=app.config-LGSV.json

# Domaines (Caddy : HTTPS automatique via Let's Encrypt)
DOMAIN=map.carte.example.org           # la carte (frontend + /api/*)
BASEROW_DOMAIN=baserow.carte.example.org  # interface Baserow de l'instance (équipe)
BASEROW_PUBLIC_URL=https://baserow.carte.example.org

# CORS (défaut : https://<DOMAIN>)
CORS_ORIGIN=https://map.carte.example.org

# ------------------------------------------------------------
# HORS de ce fichier (sur le VPS uniquement, deploy/instance/) :
#  - baserow.env  : SECRET_KEY Baserow, e-mail et mot de passe admin
#                   (générés au premier déploiement, jamais régénérés) ;
#  - backend.env  : BASEROW_API_URL (appel interne, http://baserow), BASEROW_API_TOKEN
#                   (LECTURE SEULE) et les IDs de tables (BASEROW_EVENT_TABLE_ID, BASEROW_MODERATION_FIELD_ID,
#                   BASEROW_PARTNERS_TABLE_ID, BASEROW_THEMATIQUES_TABLE_ID,
#                   BASEROW_FORMATS_TABLE_ID, BASEROW_PUBLICS_TABLE_ID),
#                   écrits par scripts/baserow-init/init.mjs.
# ------------------------------------------------------------
