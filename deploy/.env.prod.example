# ============================================================
# Variables d'environnement pour le déploiement production
# Copier ce fichier en .env.prod et remplir les valeurs
# ============================================================

# Baserow API (backend)
BASEROW_API_URL=your_baserow_url
BASEROW_API_TOKEN=your_baserow_api_token
BASEROW_EVENT_TABLE_ID=your_events_table_id_here
BASEROW_MODERATION_FIELD_ID=your_event_moderation_field_id_here
BASEROW_PARTNERS_TABLE_ID=your_partners_table_id_here
BASEROW_THEMATIQUES_TABLE_ID=your_thematiques_table_id_here
BASEROW_FORMATS_TABLE_ID=your_formats_table_id_here
BASEROW_PUBLICS_TABLE_ID=your_publics_table_id_here

# Frontend

# Domaine (pour HTTPS automatique via Caddy/Let's Encrypt)
# Utiliser "localhost" pour le développement local
# Utiliser le vrai domaine en production (ex: map.semaine-ia.fr)
DOMAIN=localhost

# CORS (laisser * pour autoriser tous les origines, ou mettre le domaine précis)
CORS_ORIGIN=*
